# Copy to .env (git-ignored) to override compose defaults. Never commit real secrets.
# Full reference: docs/plan/08-docker-and-environments.md §4

# ---- Images -----------------------------------------------------------------
IMAGE_TAG=local

# ---- MySQL (dev defaults; change outside local machines) --------------------
MYSQL_DATABASE=plantshop
MYSQL_USER=plantshop
MYSQL_PASSWORD=plantshop-dev
MYSQL_ROOT_PASSWORD=root-dev

# ---- Backend ----------------------------------------------------------------
# e2e = local login with in-memory users (works from a clean checkout)
# prod = GitHub login (requires the GITHUB_* values below)
SPRING_PROFILES_ACTIVE=e2e
# Token sources follow the profile (e2e/dev: local users, prod: GitHub). APP_AUTH_MODE=github,local
# combines both when running the backend locally in dev; local is rejected in prod.
APP_CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000
APP_SWAGGER_ENABLED=true
# Password for every in-memory user (dev/e2e only; rejected in prod)
APP_LOCAL_USER_PASSWORD=plants-dev-only

# GitHub OAuth App (prod mode). Callback URL registered at GitHub: http://127.0.0.1/
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
APP_GITHUB_ALLOWED_REDIRECT_URIS=http://127.0.0.1:3000/auth/callback,http://127.0.0.1:8080/swagger-ui/oauth2-redirect.html

# ---- Frontend (written to /config.json at container start) ------------------
API_BASE_URL=http://127.0.0.1:8080/api/v1
API_ORIGIN=http://127.0.0.1:8080
AUTH_PROVIDER=local
AUTH_AUTHORIZE_URL=http://127.0.0.1:8080/oauth2/authorize
AUTH_TOKEN_URL=http://127.0.0.1:8080/oauth2/token
AUTH_LOGOUT_URL=http://127.0.0.1:8080/connect/logout
AUTH_CLIENT_ID=plant-spa
AUTH_SCOPE=openid catalog.read cart.read cart.write
AUTH_REDIRECT_URI=http://127.0.0.1:3000/auth/callback
# GitHub mode instead:
# AUTH_PROVIDER=github
# AUTH_AUTHORIZE_URL=https://github.com/login/oauth/authorize
# AUTH_TOKEN_URL=http://127.0.0.1:8080/api/v1/auth/token
# AUTH_LOGOUT_URL=
# AUTH_CLIENT_ID=<your GitHub OAuth App client id>
# AUTH_SCOPE=read:user
