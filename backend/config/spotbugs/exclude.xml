<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs exclusions. Each entry must state why it is safe.
-->
<FindBugsFilter
    xmlns="https://github.com/spotbugs/filter/3.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">
  <!--
    EI_EXPOSE_REP / EI_EXPOSE_REP2: Spring beans receive collaborators via constructor injection and
    records expose their components by design; defensive copies would add noise without safety gain.
  -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
  <!-- Generated MapStruct implementations. -->
  <Match>
    <Class name="~.*MapperImpl"/>
  </Match>
</FindBugsFilter>
