<?xml version="1.0" encoding="UTF-8"?>
<!--
  SpotBugs exclusions. Each entry must state why it is safe.
-->
<FindBugsFilter
    xmlns="https://github.com/spotbugs/filter/3.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="https://github.com/spotbugs/filter/3.0.0 https://raw.githubusercontent.com/spotbugs/spotbugs/3.1.0/spotbugs/etc/findbugsfilter.xsd">
  <!--
    EI_EXPOSE_REP / EI_EXPOSE_REP2: Spring beans receive collaborators via constructor injection and
    records expose their components by design; defensive copies would add noise without safety gain.
  -->
  <Match>
    <Bug pattern="EI_EXPOSE_REP,EI_EXPOSE_REP2"/>
  </Match>
  <!-- Generated MapStruct implementations. -->
  <Match>
    <Class name="~.*MapperImpl"/>
  </Match>
  <!--
    HRS_REQUEST_PARAMETER_TO_HTTP_HEADER: the X-Request-Id value is only echoed after matching
    [A-Za-z0-9._-]{1,64}, so it cannot contain CR/LF; anything else is replaced by a UUID
    (RequestIdFilterTest covers the rejected inputs).
  -->
  <Match>
    <Class name="com.plantshop.common.web.RequestIdFilter"/>
    <Bug pattern="HRS_REQUEST_PARAMETER_TO_HTTP_HEADER"/>
  </Match>
</FindBugsFilter>
